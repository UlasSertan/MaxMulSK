+// -----------------------------------------------------------------------
+constexpr Entry kTable2x2[] = {
+    { 2048, { 64, 1024, 2048, false } },   // +10.6% at 2048^3, +13.9% at 4096^3
 };
 
-// >= 4096 uses the 4096 entry, which is an EXTRAPOLATION: nothing above 4096^3
